[Unit]
Description=Watchdog that stops tessera when it floods the federation or runs away
After=tessera.service postgresql.service
# Deliberately not bound to tessera.service: it has to keep watching across tessera restarts,
# and it must not be pulled down when it stops tessera itself.

[Service]
Type=simple
# Override per host in /etc/default/tessera-watchdog (TESSERA_UNIT, TESSERA_DB, MAX_TXN_PER_MIN,
# MAX_CPU, MAX_OUTBOX).
Environment=TESSERA_UNIT=tessera TESSERA_DB=tessera
EnvironmentFile=-/etc/default/tessera-watchdog
ExecStart=/usr/local/sbin/tessera-watchdog.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
