# The unit asaroton runs under. Copy it to /etc/systemd/system/asaroton.service, adjust the
# paths and the user, then: systemctl daemon-reload && systemctl enable --now asaroton
[Unit]
Description=asaroton Matrix homeserver
After=network-online.target postgresql.service
Wants=network-online.target
# A server that cannot start (a configuration it cannot read, a migration that does not
# apply) fails at once, and Restart=always would start it again every three seconds for
# ever. Ten failed starts within five minutes leave the unit failed instead. A database
# that does not answer is not caught by this, and should not be: each start waits half a
# minute for it, so ten of them take longer than the five minutes and the server comes up
# when the database does.
#
# A unit that ran into this limit refuses every start, also by hand, until
# `systemctl reset-failed asaroton`. asaroton-deploy does that before it restarts.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=asaroton
Group=asaroton
ExecStart=/usr/local/bin/asaroton --config /etc/asaroton/asaroton.toml serve
Restart=always
RestartSec=3
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The data directory from the configuration, and any other directory the server writes to.
ReadWritePaths=/var/lib/asaroton
PrivateTmp=true

[Install]
WantedBy=multi-user.target
